---
import StartPlan from "../components/StartPlan.astro";
import Base from "../layouts/Base.astro";
import { listedCourses, SCRAPED_AT } from "../lib/catalog";
import { earliestTerm, getItems, getPlan, judgedItems, termLabel } from "../lib/planner";

const session = Astro.url.searchParams.get("session") ?? "";
const level = Astro.url.searchParams.get("level") ?? "";
const q = (Astro.url.searchParams.get("q") ?? "").trim().toLowerCase();

const planId = Astro.cookies.get("plan")?.value;
const plan = planId ? getPlan(planId) : undefined;
const items = plan ? getItems(plan.id) : [];
const judged = new Map((plan ? judgedItems(plan) : []).map((item) => [item.courseCode, item]));

const courses = listedCourses().filter(
  (c) =>
    (!session || (session === "none" ? c.sessions.length === 0 : c.sessions.includes(session as never))) &&
    (!level || String(c.level) === level) &&
    (!q || `${c.code} ${c.name} ${c.description}`.toLowerCase().includes(q)),
);

const scraped = new Date(SCRAPED_AT).toLocaleDateString("en-AU", { day: "numeric", month: "long", year: "numeric" });
---

<Base title="Postgraduate computing courses" wide>
  <h1>Postgraduate computing courses</h1>
  <p class="lede">
    Every postgraduate COMP course in the ANU handbook, with its prerequisites turned from a paragraph into rules
    this site can check. Put courses into a plan and it tells you, semester by semester, what you can't take yet and
    why.
  </p>

  {
    plan ? (
      <p class="plan-banner">
        Showing where each course fits in <a href={`/plan/${plan.id}`}>your plan</a> ({items.length} courses so
        far).
      </p>
    ) : (
      <section class="plan-banner" aria-labelledby="start-heading">
        <h2 id="start-heading">Plan your degree</h2>
        <StartPlan />
        <p>
          Or look at <a href="/plan/example">an example plan</a> first.
        </p>
      </section>
    )
  }

  <form method="get" action="/" class="filters" role="search">
    <label for="q">Search</label>
    <input id="q" name="q" type="search" value={q} placeholder="code, name or topic" />
    <label for="session">Offered in</label>
    <select id="session" name="session">
      <option value="">Any semester</option>
      <option value="S1" selected={session === "S1"}>Semester 1</option>
      <option value="S2" selected={session === "S2"}>Semester 2</option>
      <option value="none" selected={session === "none"}>Not offered this year</option>
    </select>
    <label for="level">Level</label>
    <select id="level" name="level">
      <option value="">Any level</option>
      {["6000", "7000", "8000"].map((l) => <option value={l} selected={level === l}>{l}</option>)}
    </select>
    <button>Filter</button>
  </form>

  <p class="count">{courses.length} courses · handbook snapshot taken {scraped}</p>

  <ul class="course-list">
    {
      courses.map((course) => {
        const inPlan = judged.get(course.code);
        const earliest = plan && !inPlan ? earliestTerm(course, plan, items) : null;
        return (
          <li class="course-card" data-course={course.code}>
            <h2>
              <a href={`/course/${course.code}`}>
                <span class="code">{course.code}</span> {course.name}
              </a>
            </h2>
            <p class="chips">
              {course.sessions.length ? (
                course.sessions.map((s) => <span class={`chip chip-${s}`}>{s}</span>)
              ) : (
                <span class="chip chip-off">Not offered in 2026</span>
              )}
              <span class="chip chip-units">{course.units} units</span>
              {course.tree ? (
                <span class="chip">Has prerequisites</span>
              ) : (
                <span class="chip chip-open">No prerequisites</span>
              )}
            </p>
            {plan &&
              (inPlan ? (
                <p class={inPlan.warnings.length ? "fit fit-warn" : "fit fit-ok"}>
                  In your plan, {termLabel(inPlan.term)}
                  {inPlan.warnings.length ? ` · ${inPlan.warnings.length} problem${inPlan.warnings.length > 1 ? "s" : ""}` : ""}
                </p>
              ) : earliest ? (
                <p class="fit">Earliest you could take it: {termLabel(earliest)}</p>
              ) : (
                <p class="fit fit-warn">Not reachable from your plan in the next three years</p>
              ))}
          </li>
        );
      })
    }
  </ul>
</Base>
